using './main.bicep'

param location = 'uksouth'
param vmName = 'astra-soc'
param vmSize = 'Standard_D4as_v5'
param adminUsername = 'astraadmin'

// Replace locally at deployment time. Never commit a real private key.
// This repository should contain only a public SSH key if you choose to store one here.
param adminSshPublicKey = 'ssh-ed25519 REPLACE_WITH_YOUR_PUBLIC_KEY'

// Optional. Leave empty for no inbound SSH allow rule.
// If temporarily required, supply your current public IP as /32 outside version control.
param bootstrapSshSourceCidr = ''

param vnetAddressPrefix = '10.40.0.0/16'
param subnetAddressPrefix = '10.40.10.0/24'
